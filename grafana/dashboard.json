{
  "title": "Kubernetes demo API",
  "uid": "demo-api",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"demo-api\"}",
          "legendFormat": "Scrape availability"
        }
      ]
    },
    {
      "id": 2,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(demo_http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 5xx per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(demo_http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "HTTP 5xx per second"
        }
      ]
    },
    {
      "id": 4,
      "title": "Process uptime",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - process_start_time_seconds{job=\"demo-api\"}",
          "legendFormat": "Process uptime"
        }
      ]
    }
  ]
}
